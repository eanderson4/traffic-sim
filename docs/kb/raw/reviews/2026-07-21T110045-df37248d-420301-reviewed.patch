@@ -0,0 +1,57 @@
+#!/bin/sh
+# External-review gate (AGENTS.md "Review Workflow", ADR-0013).
+#
+# EVERY commit is gated except explicit documentation/generated content
+# (docs/, data/, tools/, viz dist/node_modules/public, root Markdown,
+# LICENSE, .gitignore/.gitattributes): anything else — code, contracts,
+# CI, tooling, or this mechanism itself — requires an external-review
+# stamp matching the EXACT (base HEAD, index tree) being committed —
+# proof that what ships is what Claude Fable and GPT-5.6-sol reviewed
+# (Gemini joins milestone rounds). Merge resolutions are gated too:
+# conflict resolutions are novel, unreviewed content. (See also
+# hooks/pre-merge-commit for auto-merges.)
+#
+# The stamp is written by scripts/external-review.sh after both reviewers
+# complete: byte-complete (binaries, renames), immune to diff-config
+# drift, and captured before the reviews run, so anything staged or reset
+# afterwards fails the gate. The gate proves review happened; triaging
+# findings stays the committer's job.
+set -u
+gitdir=$(git rev-parse --git-dir) # per-worktree; .git may be a file
+
+ungated_re='^(docs/|data/|tools/|viz/dist/|viz/node_modules/|viz/public/|[^/]*\.md$|\.gitignore$|\.gitattributes$|LICENSE$)'
+# NUL-safe filename handling; --no-renames so a rename OUT of a gated path
+# still surfaces its source. Anything not matching the ungated allowlist
+# is gated (inverted listing: future tooling can't slip past).
+if ! git -c core.quotePath=false diff --cached --name-only -z --no-renames --diff-filter=ACMRDT \
+    | grep -zvE "$ungated_re" | grep -qz .; then
+  exit 0 # docs/generated-only commit: no gate
+fi
+
+tree=$(git write-tree)
+base=$(git rev-parse HEAD)
+stamp="$gitdir/external-review-stamp"
+if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$base $tree" ]; then
+  exit 0
+fi
+
+if [ "${EXTERNAL_REVIEW_SKIP:-}" = "1" ]; then
+  echo "pre-commit: external-review gate SKIPPED (EXTERNAL_REVIEW_SKIP=1) — do not push this batch unreviewed" >&2
+  exit 0
+fi
+
+cat >&2 <<'EOF'
+pre-commit: staged changes touch code/contracts/tooling but have no
+matching external-review stamp. Run the gate:
+
+  scripts/external-review.sh            # Fable + Sol review the staged diff, then stamp it
+  scripts/external-review.sh --gemini   # milestone rounds: include Gemini
+
+Fix what they find, re-stage, re-run, then commit. The stamp binds the
+reviewed tree to its base HEAD, so review must precede staging. (Partial
+commits — git commit -- <paths> / -p / -a — use a temporary index; they
+pass only if that index matches the stamped tree exactly, so stage
+explicitly instead.)
+Escape hatch (noisy on purpose): EXTERNAL_REVIEW_SKIP=1 git commit ...
+EOF
+exit 1
