+		t.Errorf("origin = %q, want c_0", v.Demands[0].Flows[0].Origin)
+	}
+	if v.Manifest.Network != "net/alt.json" {
+		t.Errorf("materialized manifest network = %q, want the EFFECTIVE net/alt.json", v.Manifest.Network)
