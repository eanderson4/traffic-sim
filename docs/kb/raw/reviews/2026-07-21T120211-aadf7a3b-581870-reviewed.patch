+		t.Fatal(err)
+	}
+	before, err := Load(variantDir)
+	if err != nil {
+		t.Fatal(err)
+	}
+	if err := Format(variantDir); err != nil {
+		t.Fatalf("Format: %v", err)
+	}
+	baseAfter, err := os.ReadFile(filepath.Join(baseDir, "demand/main.yaml"))
+	if err != nil {
+		t.Fatal(err)
