+test("a reversed-fragment heading flip re-anchors instead of jackknifing", () => {
+  const a = new Articulator();
+  a.update(1, 0, 0, 0, 10, DT); // spawn aligned
+  drive(a, 1, 60, (i) => ({ x: 10 * (i + 1) * DT, y: 0, theta: 0, v: 10 }));
