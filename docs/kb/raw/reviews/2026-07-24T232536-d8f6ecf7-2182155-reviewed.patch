+package driver
+
+import (
+	"testing"
+
+	"traffic-sim/engine"
+)
+
+// router_test.go — the heap Dijkstra (router.go): shortest-by-length path
+// over the successor graph, endpoints included, early exit on settle,
+// ok=false on unknown or unreachable destinations. Synthetic diamond net
+// built in memory via CompileNet.
+
+func diamondNet(t *testing.T) *engine.Network {
+	t.Helper()
+	// A reaches D directly through the 10 m lane X, or via the 1 m lanes
+	// Y, Z. Edge weight = the ENTERED lane's length (the source lane's own
+	// length never counts), so A→Y→Z→D costs 3 against A→X→D's 11.
+	// E is an island (unreachable from everything).
+	nf := &engine.NetFile{
+		Version: 1,
+		Name:    "diamond",
+		Lanes: []engine.NetLane{
+			{ID: "a", Section: "a", Length: 5, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{0, 0}, {5, 0}}, Successors: []string{"x", "y"}},
+			{ID: "x", Section: "x", Length: 10, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{5, 0}, {15, 0}}, Successors: []string{"d"}},
+			{ID: "y", Section: "y", Length: 1, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{5, 0}, {6, 0}}, Successors: []string{"z"}},
+			{ID: "z", Section: "z", Length: 1, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{6, 0}, {7, 0}}, Successors: []string{"d"}},
+			{ID: "d", Section: "d", Length: 1, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{15, 0}, {16, 0}}, Exit: true},
+			{ID: "e", Section: "e", Length: 5, SpeedLimit: 10, Width: 3.5, Shape: [][2]float64{{0, 5}, {5, 5}}, Exit: true},
+		},
+	}
+	net, err := engine.CompileNet(nf)
+	if err != nil {
+		t.Fatalf("CompileNet: %v", err)
+	}
+	return net
+}
+
+func TestRouteShortestByLength(t *testing.T) {
+	net := diamondNet(t)
+	idx := func(id string) int { return net.LaneByID(id).Index }
+	path, ok := Route(net, idx("a"), "d")
+	if !ok {
+		t.Fatal("route a→d not found")
+	}
+	// Direct a→x→d costs 10+1; the winner is a→y→z→d at 3.
+	want := []int{idx("a"), idx("y"), idx("z"), idx("d")}
+	if len(path) != len(want) {
+		t.Fatalf("path %v, want %v", path, want)
+	}
+	for i, u := range want {
+		if path[i] != u {
+			t.Fatalf("path %v, want %v", path, want)
+		}
+	}
+	if path[0] != idx("a") || path[len(path)-1] != idx("d") {
+		t.Fatalf("path must include both endpoints: %v", path)
+	}
+}
+
+func TestRouteUnreachableAndUnknown(t *testing.T) {
+	net := diamondNet(t)
+	idx := func(id string) int { return net.LaneByID(id).Index }
+	if _, ok := Route(net, idx("e"), "d"); ok {
+		t.Fatal("island lane e must not reach d")
+	}
+	if _, ok := Route(net, idx("a"), "nope"); ok {
+		t.Fatal("unknown destination must report ok=false")
+	}
+	if _, ok := Route(net, -1, "d"); ok {
+		t.Fatal("negative fromIdx must report ok=false")
+	}
+	if _, ok := Route(net, len(net.Lanes), "d"); ok {
+		t.Fatal("out-of-range fromIdx must report ok=false")
+	}
+}
+
+func TestRouteSelfIsSingleNode(t *testing.T) {
+	net := diamondNet(t)
+	idx := func(id string) int { return net.LaneByID(id).Index }
+	path, ok := Route(net, idx("a"), "a")
+	if !ok || len(path) != 1 || path[0] != idx("a") {
+		t.Fatalf("route a→a = %v (ok %v), want the single-node path", path, ok)
+	}
+}
