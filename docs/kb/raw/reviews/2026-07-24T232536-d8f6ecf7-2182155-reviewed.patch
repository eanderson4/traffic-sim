index 0000000000000000000000000000000000000000..8cf6b368a67acf629428b260751c2b03c149b9fa
--- /dev/null
+++ b/engine/natsio/driver/router.go
@@ -0,0 +1,85 @@
+package driver
+
+import (
+	"container/heap"
+	"math"
+
+	"traffic-sim/engine"
+)
+
+// router.go — the default driver's routing: Dijkstra over the lane
+// successor graph, edge weight = lane length. Binary-heap form, O(E log V)
+// with lazy deletion: the plain O(V²) selection loop was sized for small
+// networks and took seconds-to-minutes per route on the 300k–1.4M-lane
+// city imports — called synchronously from the tick loop's Observe, one
+// burst of claims stalled the run before its first snapshot. The route
+// feeds the routing intent axis (destination lane id) and the turn choice
+// at junctions (next hop when a lane offers more than one successor).
+
+// Route computes the shortest lane path (by total lane length) from the
+// lane at fromIdx to the lane destID. The returned path is lane indices
+// including both endpoints; ok=false when the destination is unknown or
+// unreachable.
+func Route(net *engine.Network, fromIdx int, destID string) ([]int, bool) {
+	dest := net.LaneByID(destID)
+	if dest == nil || fromIdx < 0 || fromIdx >= len(net.Lanes) {
+		return nil, false
+	}
+	n := len(net.Lanes)
+	dist := make([]float64, n)
+	prev := make([]int, n)
+	for i := range dist {
+		dist[i], prev[i] = math.Inf(1), -1
+	}
+	dist[fromIdx] = 0
+	// Lazy deletion: superseded pushes stay in the heap and are skipped on
+	// pop via the dist check, so no decrease-key and no done array.
+	pq := routeHeap{{idx: fromIdx, dist: 0}}
+	for pq.Len() > 0 {
+		u := heap.Pop(&pq).(routeItem)
+		if u.dist > dist[u.idx] {
+			continue // stale: a shorter push already settled this lane
+		}
+		if u.idx == dest.Index {
+			break // dest settles: shortest found
+		}
+		for _, succ := range net.Lanes[u.idx].Successors {
+			if nd := u.dist + succ.Length; nd < dist[succ.Index] {
+				dist[succ.Index], prev[succ.Index] = nd, u.idx
+				heap.Push(&pq, routeItem{idx: succ.Index, dist: nd})
+			}
+		}
+	}
+	if math.IsInf(dist[dest.Index], 1) {
+		return nil, false
+	}
+	var path []int
+	for u := dest.Index; u >= 0; u = prev[u] {
+		path = append(path, u)
+	}
+	for i, j := 0, len(path)-1; i < j; i, j = i+1, j-1 {
+		path[i], path[j] = path[j], path[i]
+	}
+	return path, true
+}
+
+// routeItem is a Dijkstra heap entry.
+type routeItem struct {
+	idx  int
+	dist float64
+}
+
+// routeHeap is a container/heap min-heap by dist.
+type routeHeap []routeItem
+
+func (h routeHeap) Len() int           { return len(h) }
+func (h routeHeap) Less(i, j int) bool { return h[i].dist < h[j].dist }
+func (h routeHeap) Swap(i, j int)      { h[i], h[j] = h[j], h[i] }
+func (h *routeHeap) Push(x any)        { *h = append(*h, x.(routeItem)) }
+func (h *routeHeap) Pop() any {
+	old := *h
+	n := len(old)
+	it := old[n-1]
+	*h = old[:n-1]
+	return it
+}
