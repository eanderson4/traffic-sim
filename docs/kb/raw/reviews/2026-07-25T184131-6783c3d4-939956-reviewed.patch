diff --git a/deploy/docker-entrypoint.sh b/deploy/docker-entrypoint.sh
new file mode 100755
index 0000000000000000000000000000000000000000..079abc5869e75c95ee1734af13f79bbe5ab1b40b
--- /dev/null
+++ b/deploy/docker-entrypoint.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# demosrv container entrypoint: every public knob arrives via env so the
+# Deployment manifest owns configuration (deploy/k8s/deployment.yaml).
+# DEMOSRV_ADMIN_TOKEN gates the mutating endpoints (start/stop/replay
+# control) via demosrv's env intake — stripped from engine children, never
+# on argv (ADR-0020). Without it the pod refuses to boot — an
+# unauthenticated public demosrv is worse than a crash-looping one.
+set -eu
+: "${DEMOSRV_ADMIN_TOKEN:?DEMOSRV_ADMIN_TOKEN must be set (secret traffic-sim-admin)}"
+exec /opt/bin/demosrv \
+  -addr 0.0.0.0:8900 \
+  -ws 0.0.0.0:8443 \
+  -wspublic "${WS_PUBLIC_URL:-wss://ws.phantomjam.com}" \
+  -autostart "${AUTOSTART_DEMO:-sf}" \
+  -nobuild /opt/bin \
+  -demos /srv/demos.json \
+  -viz /srv/viz \
+  -netcache /data/networks/.geojson-cache \
+  -overlaydir /data/networks/overlays
diff --git a/deploy/k8s/backendconfig.yaml b/deploy/k8s/backendconfig.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..f0a8f4338624f3efcda941e0197048082307f0c3
--- /dev/null
+++ b/deploy/k8s/backendconfig.yaml
@@ -0,0 +1,28 @@
+# The L7 LB defaults to a 30 s backend timeout, which would sever any
+# websocket that goes quiet (paused run, slow viewer) and gives the /healthz
+# checks explicit paths on both backends.
+#
+# GO-LIVE PRECONDITION: the ws backend's /healthz does not exist yet (the
+# engine's embedded ws listener serves no HTTP paths). Do not apply the
+# Ingress until the engine ships /healthz — see deploy/README.md.
+apiVersion: cloud.google.com/v1
+kind: BackendConfig
+metadata:
+  name: demosrv-http-bc
+  namespace: traffic-sim
+spec:
+  timeoutSec: 3600
+  healthCheck:
+    requestPath: /api/status
+    port: 8900
+---
+apiVersion: cloud.google.com/v1
+kind: BackendConfig
+metadata:
+  name: demosrv-ws-bc
+  namespace: traffic-sim
+spec:
+  timeoutSec: 86400
+  healthCheck:
+    requestPath: /healthz
+    port: 8443
diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..7c1bfd272b55814f486e177988c7c57ec8342264
--- /dev/null
+++ b/deploy/k8s/deployment.yaml
@@ -0,0 +1,90 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: demosrv
+  namespace: traffic-sim
+spec:
+  # demosrv is a single-active-run supervisor: JetStream store exclusivity
+  # and the one ws port make replicas > 1 incorrect, not just wasteful.
+  replicas: 1
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: demosrv
+  template:
+    metadata:
+      labels:
+        app: demosrv
+    spec:
+      nodeSelector:
+        workload: traffic
+      initContainers:
+        - name: pull-data
+          image: gcr.io/google.com/cloudsdktool/google-cloud-cli:548.0.0-slim
+          # ~5 GB of scenario networks + pre-baked geojson cache; same-region
+          # pull is seconds-to-a-minute. Re-runs on every pod start, keeping
+          # data stateless — update the bucket, restart the pod.
+          command:
+            - /bin/sh
+            - -ec
+            - |
+              gcloud storage cp -r gs://roaring-bots-traffic-sim/scenarios /data/
+              mkdir -p /data/networks/.geojson-cache
+              gcloud storage cp "gs://roaring-bots-traffic-sim/netcache/*" /data/networks/.geojson-cache/
+          volumeMounts:
+            - name: data
+              mountPath: /data
+          resources:
+            requests:
+              cpu: "100m"
+              memory: 128Mi
+            limits:
+              cpu: "1"
+              memory: 512Mi
+      containers:
+        - name: demosrv
+          image: us-central1-docker.pkg.dev/roaring-bots/carbon-dev-repo/traffic-sim:v0.1.0
+          env:
+            # DEMOSRV_ADMIN_TOKEN is demosrv's documented env intake
+            # (ADR-0020): it is stripped from engine children, unlike any
+            # other env var name, and never appears on argv.
+            - name: DEMOSRV_ADMIN_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: traffic-sim-admin
+                  key: token
+            - name: WS_PUBLIC_URL
+              value: wss://ws.phantomjam.com
+            - name: AUTOSTART_DEMO
+              value: sf
+          ports:
+            - name: http
+              containerPort: 8900
+            - name: ws
+              containerPort: 8443
+          resources:
+            requests:
+              cpu: "1500m"
+              memory: 4Gi
+            limits:
+              cpu: "2"
+              memory: 6Gi
+          readinessProbe:
+            httpGet:
+              path: /api/status
+              port: http
+            initialDelaySeconds: 10
+            periodSeconds: 10
+          livenessProbe:
+            httpGet:
+              path: /api/status
+              port: http
+            initialDelaySeconds: 60
+            periodSeconds: 30
+          volumeMounts:
+            - name: data
+              mountPath: /data
+      volumes:
+        - name: data
+          emptyDir: {}
diff --git a/deploy/k8s/ingress.yaml b/deploy/k8s/ingress.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..6fcd69cdc2b51e2b7b51dd69a76d0fadac3c21d4
--- /dev/null
+++ b/deploy/k8s/ingress.yaml
@@ -0,0 +1,59 @@
+apiVersion: networking.gke.io/v1
+kind: ManagedCertificate
+metadata:
+  name: phantomjam-cert
+  namespace: traffic-sim
+spec:
+  domains:
+    - app.phantomjam.com
+    - ws.phantomjam.com
+---
+apiVersion: networking.gke.io/v1beta1
+kind: FrontendConfig
+metadata:
+  name: https-redirect
+  namespace: traffic-sim
+spec:
+  redirectToHttps:
+    enabled: true
+    responseCodeName: MOVED_PERMANENTLY_DEFAULT
+---
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: demosrv
+  namespace: traffic-sim
+  # DO NOT APPLY before the go-live preconditions in deploy/README.md land:
+  # (1) ADR-0020 gates public exposure of the engine ws plane on a broker
+  #     auth/permissions amendment — ws.phantomjam.com is that plane;
+  # (2) the ws BackendConfig health-checks /healthz, which the engine does
+  #     not serve yet — the ws backend would be permanently unhealthy.
+  annotations:
+    networking.gke.io/v1beta1.FrontendConfig: https-redirect
+    networking.gke.io/managed-certificates: phantomjam-cert
+    # Reserved global static IP (gcloud compute addresses create
+    # traffic-sim-ip --global): keeps DNS stable across ingress recreation.
+    kubernetes.io/ingress.global-static-ip-name: traffic-sim-ip
+spec:
+  ingressClassName: gce
+  rules:
+    - host: app.phantomjam.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: demosrv
+                port:
+                  name: http
+    - host: ws.phantomjam.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: demosrv
+                port:
+                  name: ws
