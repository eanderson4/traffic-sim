+// Parallel internal lanes of different lengths feeding one exit: the actual
+// despawn path is unobservable — the shortest chain books and the ambiguity
+// is loud; same-length parallels book silently.
+func TestExitSharesAmbiguousPath(t *testing.T) {
+	prev := &Lane{ID: "P", Length: 500, SpeedLimit: 33.3}
+	m1 := &Lane{ID: "M1", Length: 1, SpeedLimit: 33.3}
+	m2 := &Lane{ID: "M2", Length: 3, SpeedLimit: 33.3}
+	x := &Lane{ID: "X", Length: 100, SpeedLimit: 33.3, Exit: true}
+	prev.Successors = []*Lane{m1, m2}
+	m1.Successors = []*Lane{x}
+	m2.Successors = []*Lane{x}
+	obs := mLastObs{lane: prev, s: 499, v: 33.3, vt: &Car, f: 1}
+	shares, exit, ok, ambiguous := exitShares(obs)
+	if !ok || !ambiguous || exit != x {
+		t.Errorf("exitShares = ok %v ambiguous %v exit %v, want ok+ambiguous, exit X", ok, ambiguous, exit)
+	}
+	var total float64
+	for _, sh := range shares {
+		total += sh.d
+	}
+	if !closeWithin(total, 1+1+100) {
+		t.Errorf("booked %v m, want %v (prev remainder + shortest chain)", total, 1.0+1+100)
+	}
+	m2.Length = 1 // same total on both chains — attribution still arbitrary ⇒ loud
+	if _, _, ok, ambiguous := exitShares(obs); !ok || !ambiguous {
+		t.Errorf("identical-length parallels: ok %v ambiguous %v, want loud (arbitrary attribution)", ok, ambiguous)
+	}
+	// Three divergent paths to the one exit: the enumeration cap truncates —
+	// truncation itself is ambiguous (loud).
+	m2.Length = 3
+	m3 := &Lane{ID: "M3", Length: 5, SpeedLimit: 33.3}
+	m3.Successors = []*Lane{x}
+	prev.Successors = []*Lane{m1, m2, m3}
+	if _, _, ok, ambiguous := exitShares(obs); !ok || !ambiguous {
+		t.Errorf("cap-truncated exit enumeration: ok %v ambiguous %v, want loud", ok, ambiguous)
+	}
+}
