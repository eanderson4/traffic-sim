+  drive(a, 1, 60, (i) => ({ x: 10 * (i + 1) * DT, y: 0, theta: 0, v: 10 }));
+  // Upset to ~100° while the truck is stopped: the queued hold must not
+  // protect a pose past the glitch clamp.
