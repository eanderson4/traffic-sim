+++    def test_pin_of_one_leaves_nothing_elsewhere(self):
+++        got = zshare(W, Z, {"cbd": 1.0})
+++        self.assertAlmostEqual(got["cbd"], 1.0)
+++        self.assertNotIn("near-north", got)
