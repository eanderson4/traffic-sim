++            {"kind": "portal", "profile": "flat"},
++            {"kind": "portal", "profile": "am"},
++        ])
++        slices, _ = ps.resolve("portal", None, None)
++        self.assertEqual([f for _, _, f in slices], [0.4, 0.4, 0.4])
