+++    ] as const) {
+++      const c = el("div", "fp-card");
+++      c.appendChild(el("div", "fp-k", k));
+++      c.appendChild(el("div", "fp-v", v));
+++      cards.appendChild(c);
+++    }
+++    body.appendChild(cards);
+++
+++    const W = this.width();
+++    body.appendChild(
+++      this.chart(
+++        cumulativeGeom(doc, W, 108),
