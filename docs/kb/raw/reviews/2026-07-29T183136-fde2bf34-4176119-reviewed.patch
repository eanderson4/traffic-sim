+++  );
+++  assert.deepEqual(
+++    sortGroupRows(rows, "pct_lane_km_over_critical", true).map(([n]) => n),
+++    ["dan-ryan", "lsd", "(arterial grid)"],
+++  );
+++  // Ties fall back to name, so a re-sort is stable.
+++  const tied: Record<string, GroupRow> = {
