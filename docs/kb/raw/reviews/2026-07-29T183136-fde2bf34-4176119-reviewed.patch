++        # 80% of the CBD's area is on d1; pinning the district must not
++        # redistribute WITHIN it.
++        got = zone_blend(W, Z, {"cbd": 0.50})
++        self.assertAlmostEqual(got["d1"], 0.50 * 0.75)
++        self.assertAlmostEqual(got["d2"], 0.50 * 0.25)
