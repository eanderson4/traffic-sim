+++def pcfg(**kw):
+++    d = {
+++        "version": 1,
+++        "step_s": 600,
+++        "profiles": {"am": [0.5, 1.0, 0.5], "flat": [0.4, 0.4, 0.4]},
+++        "default": "am",
+++        "assign": [{"kind": "resident", "profile": "flat", "scale": 0.5}],
+++    }
+++    d.update(kw)
+++    return d
