++++def colour_for(speed_ms, limit_ms):
++++    if limit_ms <= 0:
++++        return EMPTY
++++    r = speed_ms / limit_ms
++++    for hi, rgb in BANDS:
++++        if r < hi:
++++            return rgb
++++    return BANDS[-1][1]
