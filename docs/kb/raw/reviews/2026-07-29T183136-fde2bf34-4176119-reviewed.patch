++test("curveGeometry: x is real minutes at interval midpoints", () => {
++  const curve: CurvePoint[] = [
++    {
++      begin_min: 10,
++      end_min: 15,
++      speed: 25.7,
++      k: 3.1,
++      fw_speed: 39.5,
++      fw_k: 5.0,
++      pct_over_critical: 1.9,
++      pct_fwy_over_critical: 3.5,
++    },
++    {
++      begin_min: 15,
++      end_min: 20,
++      speed: 18.7,
++      k: 4.1,
++      fw_speed: 27.6,
++      fw_k: 6.2,
++      pct_over_critical: 3.0,
++      pct_fwy_over_critical: 5.6,
++    },
++  ];
