++        got = zshare(W, Z, {"cbd": 0.50})
++        # near-north and south hold 15 and 5 of the 20 unpinned units.
++        self.assertAlmostEqual(got["near-north"], 0.50 * 0.75)
++        self.assertAlmostEqual(got["south"], 0.50 * 0.25)
