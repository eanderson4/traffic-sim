+        ivs = [interval("busy", 0, 36000, 60000.0, 3600.0)]
+        out, _ = self.run_report(lanes, ivs, ticks=36000)
+        self.assertAlmostEqual(out["totals"]["lane_km"], 10.0, places=6)
+
