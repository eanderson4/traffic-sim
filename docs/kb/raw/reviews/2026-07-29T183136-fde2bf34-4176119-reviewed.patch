++    def test_several_pins_compose(self):
++        got = zshare(W, Z, {"cbd": 0.40, "south": 0.40})
++        self.assertAlmostEqual(got["cbd"], 0.40)
++        self.assertAlmostEqual(got["south"], 0.40)
++        self.assertAlmostEqual(got["near-north"], 0.20)
