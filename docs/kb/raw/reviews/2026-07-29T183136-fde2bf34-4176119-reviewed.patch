+++    def test_only_the_pinned_district_reachable_absorbs_the_remainder(self):
+++        w = {"d1": 60.0, "d2": 20.0}
+++        got = zshare(w, Z, {"cbd": 0.40})
+++        self.assertAlmostEqual(got["cbd"], 1.0)
