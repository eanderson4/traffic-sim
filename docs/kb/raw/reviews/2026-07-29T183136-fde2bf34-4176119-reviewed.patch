+++    if n <= 0 or not items:
+++        return []
+++    chosen = [items[0]]
+++    if n == 1:
+++        return chosen
+++    best = [math.dist(pos(it), pos(items[0])) for it in items]
+++    while len(chosen) < min(n, len(items)):
+++        k = max(range(len(items)), key=lambda i: (best[i], -i))
