++++      }
++++    }
++++    for (const ser of g.series) {
++++      s.appendChild(svg("path", { class: `fp-line fp-s-${ser.key}`, d: ser.path }));
++++    }
++++    // The marker is added last so it draws over every series.
++++    const m = svg("line", {
