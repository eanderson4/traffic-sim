+++  assert.equal(criticalK({ ...REPORT, critical_k: 0 }), LEGACY_CRITICAL_K);
+++  // The %crit column names whatever the report cut its bands against.
+++  assert.match(groupColumns(18).find((c) => c.label === "%crit")!.title, /18 veh\/km\/lane/);
