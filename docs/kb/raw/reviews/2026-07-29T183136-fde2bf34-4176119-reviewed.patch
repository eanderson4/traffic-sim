+++def profile_args(**kw):
+++    """The subset of the CLI namespace build_profile reads."""
+++    d = dict(flat_peak=False, slice_s=1800.0, drain_s=0.0, drain_level=0.0,
+++             horizon_s=0.0)
+++    d.update(kw)
+++    return types.SimpleNamespace(**d)
