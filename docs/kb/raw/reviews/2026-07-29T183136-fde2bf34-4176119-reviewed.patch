++    def test_shared_horizontal_edge_claims_a_point_exactly_once(self):
++        lower = UNIT
++        upper = [[0.0, 1.0], [1.0, 1.0], [1.0, 2.0], [0.0, 2.0], [0.0, 1.0]]
++        hits = sum(mkzones.in_ring((0.5, 1.0), r) for r in (lower, upper))
++        self.assertEqual(hits, 1)
