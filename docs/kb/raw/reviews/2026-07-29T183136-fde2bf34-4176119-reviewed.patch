+++    fi
+++    python3 scripts/show/mkcongestionmap.py \
+++        --network data/networks/chi-loop-urban/chi-loop-urban.json \
+++        --metrics "$CHI_METRICS" --warmup-tick "${CHI_WARMUP:-4000}" \
+++        --end-tick "${CHI_END:-12000}" \
