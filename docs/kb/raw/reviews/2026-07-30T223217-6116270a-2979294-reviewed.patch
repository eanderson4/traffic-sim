+			e.routeEpochs[x0.Index], e.routeEpochs[y0.Index])
+	}
+	// Next tick's budget recomputes the second table on demand.
+	vc := e.AddInitialVehicle(a0, 0, 499.5, 33.3, 1)
+	vc.Route = "y_0"
+	for i := 0; i < 5 && vc.Lane != nil && vc.Lane.ID == "a_0"; i++ {
