++  <way id="8910112">
++    <nd ref="101"/>
++    <nd ref="102"/>
++    <nd ref="103"/>
++    <tag k="highway" v="primary"/>
++    <tag k="name" v="Market &amp; &quot;4th&quot; St"/>
++    <tag k="oneway" v="yes"/>
