++                way(11, [9, 4, 3]),
++                stop(8, direction="forward"),
++                stop(4, direction="forward"),
++            ]
++        }
++        self.assertEqual(resolve(data), {3: "allway_stop"})
++
++    def test_partial_arms_is_priority(self) -> None:
