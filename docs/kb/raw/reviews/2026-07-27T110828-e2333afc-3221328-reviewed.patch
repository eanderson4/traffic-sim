diff --git a/viz/test/config.test.ts b/viz/test/config.test.ts
index b7062c5ad09419b9c33fa0045e4e36cf20aa82b8..80702ed3bd776d22b7663878c99b66c289af7b0b 100644
--- a/viz/test/config.test.ts
