+	for _, tick := range snaps.snaps()[pauseIdx:] {
+		if tick != pausedTick {
+			t.Fatalf("snapshot at tick %d while paused at %d", tick, pausedTick)
+		}
+		repubs++
+	}
+	if repubs == 0 {
+		t.Fatal("no paused republication within 1.2 s")
+	}
+
