++	}
++	p := warm.AddInitialVehicle(laneOf(t, warm, "a_0"), 0, 499.5, 33.3, 1)
++	p.Route = "x_0"
++	for warm.Tick < 1400 {
++		warm.Step()
++	}
++	// CRCs are per-Step append-only and NOT restored: warm.CRCs[0] is the
++	// first post-restore tick (split+1), full.CRCs[i] is tick i+1.
++	for i := split; i < 1400; i++ {
