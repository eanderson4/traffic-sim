++		t.Fatalf("budgeted recompute: crossed to %v, want b_0", va.Lane)
++	}
++	if vb.Lane == nil || vb.Lane.ID != "c_0" {
++		t.Fatalf("past-budget asker: crossed to %v, want the stale c_0", vb.Lane)
++	}
++	if e.rerouteBudget != 0 {
++		t.Fatalf("rerouteBudget = %d after one recompute with budget 1", e.rerouteBudget)
++	}
++	if e.routeEpochs[x0.Index] != 1 || e.routeEpochs[y0.Index] != 0 {
++		t.Fatalf("epochs = (%d, %d), want (1, 0) — only the budgeted table recomputed",
++			e.routeEpochs[x0.Index], e.routeEpochs[y0.Index])
++	}
++	// Next tick's budget recomputes the second table on demand.
++	vc := e.AddInitialVehicle(a0, 0, 499.5, 33.3, 1)
