++	data, err := e.MarshalState()
++	if err != nil {
++		t.Fatal(err)
++	}
++	if ver := binary.LittleEndian.Uint16(data[4:6]); ver != keyframeAdaptiveVersion {
++		t.Fatalf("flag-on state marshalled as v%d, want v%d", ver, keyframeAdaptiveVersion)
++	}
