++		t.Fatalf("first asker: crossed to %v, want b_0", va.Lane)
++	}
++	if vb.Lane == nil || vb.Lane.ID != "b_0" {
++		t.Fatalf("second asker: crossed to %v, want b_0 — no stale table may be served", vb.Lane)
++	}
