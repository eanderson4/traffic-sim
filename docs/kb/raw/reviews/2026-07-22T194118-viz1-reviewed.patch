diff --git a/viz/src/glyphs.ts b/viz/src/glyphs.ts
new file mode 100644
index 0000000000000000000000000000000000000000..98aee6822cbbfe582c76a65a7ffad91472d18f40
--- /dev/null
+++ b/viz/src/glyphs.ts
@@ -0,0 +1,50 @@
+// glyphs.ts — rotated-rectangle vehicle symbols. One white rectangle drawn
+// to an offscreen canvas and registered with { sdf: true } so a single
+// image serves every class: icon-color tints it, icon-rotate aims it along
+// the heading, icon-size scales it. The rect is drawn VERTICALLY (long
+// axis = image north) so icon-rotate can take the bearing from
+// theme.ts:vehicleBearingDeg directly — at bearing 0 (heading north) the
+// unrotated image already reads as a vehicle pointing up-screen.
+//
+// Glyphs are screen-space by design: at corridor zooms (11–15) true-metric
+// vehicle polygons render sub-pixel, so legibility wins over scale fidelity
+// — class and heading are the data being encoded, not footprint. Class
+// proportions still come from the real engine dimensions (theme.ts GLYPHS).
+
+import { GLYPHS } from "./theme.ts";
+
+// Image canvas 32×64 px with 8 px of padding around the white rect; the
+// padding gives the SDF field room to fall off. At icon-size 1 the visible
+// rect is 48 px long (RECT_LEN_PX).
+const IMG_W = 32;
+const IMG_H = 64;
+const PAD = 8;
+export const RECT_LEN_PX = IMG_H - 2 * PAD; // 48
+
+export function makeVehicleRectImage(): ImageData {
+  const canvas = document.createElement("canvas");
+  canvas.width = IMG_W;
+  canvas.height = IMG_H;
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("glyphs: 2d canvas context unavailable");
+  ctx.fillStyle = "#ffffff";
+  ctx.fillRect(PAD, PAD, IMG_W - 2 * PAD, IMG_H - 2 * PAD);
+  return ctx.getImageData(0, 0, IMG_W, IMG_H);
+}
+
+// Car target: ~9 px long at zoom 14 — small enough that queued platoons
+// stay separable, big enough to read the heading. icon-size scales the
+// 48 px rect, so 9 px ⇒ 0.19.
+export const CAR_ICON_SIZE_STOPS: Array<[number, number]> = [
+  [11, 0.09],
+  [14, 0.19],
+  [17, 0.45],
+];
+
+// Length ratio between classes, from the real engine dimensions: trucks
+// render 12/5 = 2.4× longer than cars at every zoom.
+export function classLengthScale(cls: number): number {
+  const car = GLYPHS[0]!;
+  const g = GLYPHS.find((g) => g.cls === cls);
+  return g === undefined ? 1 : g.lengthM / car.lengthM;
+}
