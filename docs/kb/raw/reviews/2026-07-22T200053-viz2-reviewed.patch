index 0000000000000000000000000000000000000000..0413f8555a02c3abdbbf19c0c2540d39d8955172
--- /dev/null
+++ b/viz/src/glyphs.ts
@@ -0,0 +1,61 @@
+// glyphs.ts — rotated-rectangle vehicle symbols. Each class gets its OWN
+// white rectangle drawn to an offscreen canvas at its true aspect ratio
+// (engine dims via theme.ts GLYPHS, one shared pixel-per-metre scale) and
+// registered with { sdf: true }: icon-image picks the class, icon-color
+// tints, icon-rotate aims, and ONE icon-size zoom interpolation serves
+// every class. A single image with a per-class icon-size multiplier was
+// tried first and dropped — uniform scaling made trucks 2.4× WIDER as well
+// as longer, spanning adjacent lanes. With per-class images, trucks are
+// 2.4× longer but only 1.25× wider: honest proportions.
+//
+// Rects are drawn VERTICALLY (long axis = image north) so icon-rotate can
+// take the bearing from theme.ts:vehicleBearingDeg directly — at bearing 0
+// (heading north) the unrotated image already reads as a vehicle pointing
+// up-screen.
+//
+// Glyphs are screen-space by design: at corridor zooms (11–15) true-metric
+// vehicle polygons render sub-pixel, so legibility wins over scale fidelity
+// — class and heading are the data being encoded, not footprint. The
+// proportions BETWEEN classes stay honest (same px/m for every image).
+
+import { GLYPHS, type GlyphSpec } from "./theme.ts";
+
+// Shared pixel-per-metre across class images keeps their proportions
+// honest; PAD gives the SDF field room to fall off.
+const PX_PER_M = 10;
+const PAD = 8;
+
+// glyphFor maps a wire class id to its glyph spec; unknown classes fall
+// back to the last entry (truck), matching the style expressions' default.
+export function glyphFor(cls: number): GlyphSpec {
+  return GLYPHS.find((g) => g.cls === cls) ?? GLYPHS[GLYPHS.length - 1]!;
+}
+
+export function glyphImageId(g: GlyphSpec): string {
+  return `veh-rect-${g.name}`;
+}
+
+// makeVehicleRectImage draws class g's white rect (vertical, true aspect
+// ratio at PX_PER_M) with PAD px of transparent SDF padding. At icon-size 1
+// the visible rect is lengthM × PX_PER_M px long.
+export function makeVehicleRectImage(g: GlyphSpec): ImageData {
+  const w = Math.round(g.widthM * PX_PER_M) + 2 * PAD;
+  const h = Math.round(g.lengthM * PX_PER_M) + 2 * PAD;
+  const canvas = document.createElement("canvas");
+  canvas.width = w;
+  canvas.height = h;
+  const ctx = canvas.getContext("2d");
+  if (!ctx) throw new Error("glyphs: 2d canvas context unavailable");
+  ctx.fillStyle = "#ffffff";
+  ctx.fillRect(PAD, PAD, w - 2 * PAD, h - 2 * PAD);
+  return ctx.getImageData(0, 0, w, h);
+}
+
+// One zoom curve for every class: a car (50 px rect) is ~9 px long at
+// zoom 14 — small enough that queued platoons stay separable, big enough
+// to read the heading.
+export const ICON_SIZE_STOPS: Array<[number, number]> = [
+  [11, 0.086],
+  [14, 0.18],
+  [17, 0.43],
+];
