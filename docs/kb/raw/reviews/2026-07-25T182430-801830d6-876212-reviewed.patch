diff --git a/deploy/docker-entrypoint.sh b/deploy/docker-entrypoint.sh
new file mode 100755
index 0000000000000000000000000000000000000000..b0be067acef2e5b0745ab7faf8122b97e7a095d0
--- /dev/null
+++ b/deploy/docker-entrypoint.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+# demosrv container entrypoint: every public knob arrives via env so the
+# Deployment manifest owns configuration (deploy/k8s/deployment.yaml).
+# ADMIN_TOKEN gates the mutating endpoints (start/stop/replay control);
+# without it the pod refuses to boot — an unauthenticated public demosrv
+# is worse than a crash-looping one.
+set -eu
+: "${ADMIN_TOKEN:?ADMIN_TOKEN must be set (secret traffic-sim-admin)}"
+exec /opt/bin/demosrv \
+  -addr 0.0.0.0:8900 \
+  -ws 0.0.0.0:8443 \
+  -wspublic "${WS_PUBLIC_URL:-wss://ws.phantomjam.com}" \
+  -admintoken "$ADMIN_TOKEN" \
+  -autostart "${AUTOSTART_DEMO:-sf}" \
+  -nobuild /opt/bin \
+  -demos /srv/demos.json \
+  -viz /srv/viz \
+  -netcache /data/networks/.geojson-cache \
+  -overlaydir /data/networks/overlays
diff --git a/deploy/k8s/backendconfig.yaml b/deploy/k8s/backendconfig.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..98fc7b432dcd1a423a0af204889dc826a0f70a0d
--- /dev/null
+++ b/deploy/k8s/backendconfig.yaml
@@ -0,0 +1,24 @@
+# The L7 LB defaults to a 30 s backend timeout, which would sever any
+# websocket that goes quiet (paused run, slow viewer) and gives the /healthz
+# checks explicit paths on both backends.
+apiVersion: cloud.google.com/v1
+kind: BackendConfig
+metadata:
+  name: demosrv-http-bc
+  namespace: traffic-sim
+spec:
+  timeoutSec: 3600
+  healthCheck:
+    requestPath: /api/status
+    port: 8900
+---
+apiVersion: cloud.google.com/v1
+kind: BackendConfig
+metadata:
+  name: demosrv-ws-bc
+  namespace: traffic-sim
+spec:
+  timeoutSec: 86400
+  healthCheck:
+    requestPath: /healthz
+    port: 8443
diff --git a/deploy/k8s/deployment.yaml b/deploy/k8s/deployment.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..807c9ec220f05b02b7e58742eaab486ed66721d1
--- /dev/null
+++ b/deploy/k8s/deployment.yaml
@@ -0,0 +1,80 @@
+apiVersion: apps/v1
+kind: Deployment
+metadata:
+  name: demosrv
+  namespace: traffic-sim
+spec:
+  # demosrv is a single-active-run supervisor: JetStream store exclusivity
+  # and the one ws port make replicas > 1 incorrect, not just wasteful.
+  replicas: 1
+  strategy:
+    type: Recreate
+  selector:
+    matchLabels:
+      app: demosrv
+  template:
+    metadata:
+      labels:
+        app: demosrv
+    spec:
+      nodeSelector:
+        workload: traffic
+      initContainers:
+        - name: pull-data
+          image: gcr.io/google.com/cloudsdktool/google-cloud-cli:slim
+          # ~5 GB of scenario networks + pre-baked geojson cache; same-region
+          # pull is seconds-to-a-minute. Re-runs on every pod start, keeping
+          # data stateless — update the bucket, restart the pod.
+          command:
+            - /bin/sh
+            - -ec
+            - |
+              gcloud storage cp -r gs://roaring-bots-traffic-sim/scenarios/. /data/scenarios/
+              mkdir -p /data/networks/.geojson-cache
+              gcloud storage cp -r gs://roaring-bots-traffic-sim/netcache/. /data/networks/.geojson-cache/
+          volumeMounts:
+            - name: data
+              mountPath: /data
+      containers:
+        - name: demosrv
+          image: us-central1-docker.pkg.dev/roaring-bots/carbon-dev-repo/traffic-sim:v0.1.0
+          env:
+            - name: ADMIN_TOKEN
+              valueFrom:
+                secretKeyRef:
+                  name: traffic-sim-admin
+                  key: token
+            - name: WS_PUBLIC_URL
+              value: wss://ws.phantomjam.com
+            - name: AUTOSTART_DEMO
+              value: sf
+          ports:
+            - name: http
+              containerPort: 8900
+            - name: ws
+              containerPort: 8443
+          resources:
+            requests:
+              cpu: "1500m"
+              memory: 4Gi
+            limits:
+              cpu: "2"
+              memory: 6Gi
+          readinessProbe:
+            httpGet:
+              path: /api/status
+              port: http
+            initialDelaySeconds: 10
+            periodSeconds: 10
+          livenessProbe:
+            httpGet:
+              path: /api/status
+              port: http
+            initialDelaySeconds: 60
+            periodSeconds: 30
+          volumeMounts:
+            - name: data
+              mountPath: /data
+      volumes:
+        - name: data
+          emptyDir: {}
diff --git a/deploy/k8s/ingress.yaml b/deploy/k8s/ingress.yaml
new file mode 100644
index 0000000000000000000000000000000000000000..76d404ae6b98a18aaf87ae3fccfdb95eae58fffa
--- /dev/null
+++ b/deploy/k8s/ingress.yaml
@@ -0,0 +1,43 @@
+apiVersion: networking.gke.io/v1
+kind: ManagedCertificate
+metadata:
+  name: phantomjam-cert
+  namespace: traffic-sim
+spec:
+  domains:
+    - app.phantomjam.com
+    - ws.phantomjam.com
+---
+apiVersion: networking.k8s.io/v1
+kind: Ingress
+metadata:
+  name: demosrv
+  namespace: traffic-sim
+  annotations:
+    networking.gke.io/managed-certificates: phantomjam-cert
+    kubernetes.io/ingress.class: gce
+    # Reserved global static IP (gcloud compute addresses create
+    # traffic-sim-ip --global): keeps DNS stable across ingress recreation.
+    kubernetes.io/ingress.global-static-ip-name: traffic-sim-ip
+spec:
+  rules:
+    - host: app.phantomjam.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: demosrv
+                port:
+                  name: http
+    - host: ws.phantomjam.com
+      http:
+        paths:
+          - path: /
+            pathType: Prefix
+            backend:
+              service:
+                name: demosrv
+                port:
+                  name: ws
