+#!/bin/sh
+# External-review gate (AGENTS.md "Review Workflow", ADR-0013).
+#
+# Commits touching code, contracts, tooling, or the review mechanism
+# itself (engine/, viz/ minus generated content, contracts/, analysis/,
+# scripts/, hooks/, .kimi-code/skills/) require an external-review stamp
+# matching the EXACT staged tree — proof that what is about to be
+# committed is what Claude Fable and GPT-5.6-sol reviewed (Gemini joins
+# milestone rounds). Docs/KB-only commits pass.
+#
+# The stamp is the index tree hash written by
+# scripts/external-review.sh after both reviewers complete: byte-complete
+# (binaries, renames), immune to diff-config drift, and captured before
+# the reviews run, so anything staged afterwards fails the gate. The gate
+# proves review happened; triaging findings stays the committer's job.
+set -u
+gitdir=$(git rev-parse --git-dir) # per-worktree; .git may be a file
+
+gated=$(git -c core.quotePath=false diff --cached --name-only --no-renames --diff-filter=ACMRDT \
+  | grep -E '^(engine/|viz/|contracts/|analysis/|scripts/|hooks/|\.kimi-code/skills/)' \
+  | grep -vE '^viz/(dist|node_modules|public)/' || true)
+[ -z "$gated" ] && exit 0 # docs/KB-only (or generated-content-only) commit: no gate
+
+# Concluding a merge: the parents' changes were reviewed on their own
+# branches; there is no meaningful "merge diff" to gate (ADR-0013 §4).
+[ -f "$gitdir/MERGE_HEAD" ] && exit 0
+
+tree=$(git write-tree)
+base=$(git rev-parse HEAD)
+stamp="$gitdir/external-review-stamp"
+if [ -f "$stamp" ] && [ "$(cat "$stamp")" = "$base $tree" ]; then
+  exit 0
+fi
+
+if [ "${EXTERNAL_REVIEW_SKIP:-}" = "1" ]; then
+  echo "pre-commit: external-review gate SKIPPED (EXTERNAL_REVIEW_SKIP=1) — do not push this batch unreviewed" >&2
+  exit 0
+fi
+
+cat >&2 <<'EOF'
+pre-commit: staged changes touch code/contracts/tooling but have no
+matching external-review stamp. Run the gate:
+
+  scripts/external-review.sh            # Fable + Sol review the staged diff, then stamp it
+  scripts/external-review.sh --gemini   # milestone rounds: include Gemini
+
+Fix what they find, re-stage, re-run, then commit. The stamp binds the
+reviewed tree to its base HEAD, so review must precede staging. (Partial
+commits — git commit -- <paths> / -p / -a — use a temporary index and
+always fail this gate; stage explicitly instead.)
+Escape hatch (noisy on purpose): EXTERNAL_REVIEW_SKIP=1 git commit ...
+EOF
+exit 1
