+test("getTheme resolves known names and falls back to navy", () => {
+  assert.equal(getTheme("navy"), THEMES.navy);
+  assert.equal(getTheme("paper"), THEMES.paper);
+  assert.equal(getTheme("bogus"), THEMES.navy);
