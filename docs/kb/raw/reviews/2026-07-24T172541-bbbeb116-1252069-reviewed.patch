+id: chunk-test
+seed: 7
+ticks: 300
+network: network.json
+types: [car]
+spawner:
+  rate_per_lane_h: 600
+`
+	if err := os.WriteFile(filepath.Join(dir, "scenario.yaml"), []byte(manifest), 0o644); err != nil {
+		t.Fatal(err)
+	}
