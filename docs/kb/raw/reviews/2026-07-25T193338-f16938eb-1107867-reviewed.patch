++            pathType: Prefix
++            backend:
++              service:
++                name: demosrv
++                port:
++                  name: http
++    - host: ws.phantomjam.com
++      http:
++        paths:
++          - path: /
++            pathType: Prefix
++            backend:
++              service:
++                name: demosrv
++                port:
++                  name: ws
