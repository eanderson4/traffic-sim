++		t.Fatal("status after shutdown-aborted autostart = active, want idle")
++	}
++	mu.Lock()
++	n := len(cmds)
++	mu.Unlock()
++	if n != 0 {
++		t.Errorf("%d spawns after shutdown, want 0", n)
++	}
++}
