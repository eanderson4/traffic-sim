++            - name: AUTOSTART_DEMO
++              value: sf
++          ports:
++            - name: http
++              containerPort: 8900
++            - name: ws
++              containerPort: 8443
++          resources:
++            requests:
++              cpu: "1500m"
++              memory: 4Gi
++            limits:
++              cpu: "2"
++              memory: 6Gi
++          readinessProbe:
++            httpGet:
++              path: /api/status
++              port: http
++            initialDelaySeconds: 10
++            periodSeconds: 10
++          livenessProbe:
++            httpGet:
++              path: /api/status
++              port: http
++            initialDelaySeconds: 60
++            periodSeconds: 30
++          volumeMounts:
++            - name: data
++              mountPath: /data
