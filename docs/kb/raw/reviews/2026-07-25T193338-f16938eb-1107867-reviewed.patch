++// resolveAdminToken: the flag wins, the env backs it up (K8s Secret →
++// env, keeping the token out of argv), both empty = open, and a
++// whitespace-only env value is a fail-CLOSED error (a malformed Secret
++// must never silently deploy the gate open — sol, round 7).
++func TestResolveAdminToken(t *testing.T) {
++	t.Setenv(adminTokenEnv, "env-tok")
++	if got, err := resolveAdminToken("flag-tok"); err != nil || got != "flag-tok" {
++		t.Errorf("flag set = (%q, %v), want the flag value to win", got, err)
++	}
++	if got, err := resolveAdminToken(""); err != nil || got != "env-tok" {
++		t.Errorf("flag empty = (%q, %v), want the env fallback", got, err)
++	}
++	// A trailing newline (the echo-into-Secret footgun) is trimmed.
++	t.Setenv(adminTokenEnv, "env-tok\n")
++	if got, err := resolveAdminToken(""); err != nil || got != "env-tok" {
++		t.Errorf("env with newline = (%q, %v), want it trimmed", got, err)
++	}
++	// Whitespace-only: set but effectively empty = startup refusal.
++	t.Setenv(adminTokenEnv, " \n")
++	if got, err := resolveAdminToken(""); err == nil || got != "" {
++		t.Errorf("whitespace-only env = (%q, %v), want a fail-closed error", got, err)
++	}
++	t.Setenv(adminTokenEnv, "")
++	if got, err := resolveAdminToken(""); err != nil || got != "" {
++		t.Errorf("both empty = (%q, %v), want open", got, err)
++	}
++}
