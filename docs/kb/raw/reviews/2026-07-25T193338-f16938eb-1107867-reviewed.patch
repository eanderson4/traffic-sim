++  replicas: 1
++  strategy:
++    type: Recreate
++  selector:
++    matchLabels:
++      app: demosrv
++  template:
++    metadata:
++      labels:
++        app: demosrv
++    spec:
++      automountServiceAccountToken: false
++      securityContext:
++        runAsNonRoot: true
++        runAsUser: 1000
++        fsGroup: 1000
++      nodeSelector:
