++				t.Errorf("POST %s: 401 body echoes a credential: %q", path, body)
++			}
++			if hdr.Get("WWW-Authenticate") != "Bearer" {
++				t.Errorf("POST %s: WWW-Authenticate = %q, want Bearer", path, hdr.Get("WWW-Authenticate"))
++			}
++		}
++	}
