+        minx, maxx = min(minx, pts[:, 0].min()), max(maxx, pts[:, 0].max())
+        miny, maxy = min(miny, pts[:, 1].min()), max(maxy, pts[:, 1].max())
+        segs = np.stack([pts[:-1], pts[1:]], axis=1)
+        (fast_blocks if lane.get("speedLimit", 0) >= FAST_MS else slow_blocks).append(segs)
+
