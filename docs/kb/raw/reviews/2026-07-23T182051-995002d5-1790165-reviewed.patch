+	}
+	st, err := os.Stat(abs)
+	if err != nil {
+		return "", fmt.Errorf("demos registry %s: %s %s: %w", where, field, p, err)
+	}
+	if !st.IsDir() {
+		return "", fmt.Errorf("demos registry %s: %s %s is not a directory", where, field, p)
+	}
+	return abs, nil
+}
+
