+  onFrame(10, 1000);
+  onFrame(11, 1100);
+  onFrame(4, 1200); // seek
+  onFrame(5, 1300); // replay resumes forward
+  // renderAt = 1250 → t = 0.5 between the landing frame and the next one.
+  const s = b.sample(1500)!;
