<?xml version="1.0" encoding="UTF-8"?>

<!-- Hand-authored fixture for the netimport tests: a two-lane arterial E0
     feeding a priority junction J1 (straight onto E1, left turn onto E2)
     through junction-internal lanes, a signalized map-edge junction J2
     (reported, unmodeled), plus a rail edge and a sidewalk lane that the
     converter must skip. Shapes are metric (fake UTM frame). NOT produced
     by netconvert — it only covers what the converter reads. -->
<net version="1.16" junctionCornerDetail="5" limit="400" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/net_file.xsd">

